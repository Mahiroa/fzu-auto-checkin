# ---- 敏感信息，勿提交 ----
config.yaml
config.yml
# Go 服务的运行时数据：里面有密码哈希、Session 密钥、token 与全部运行历史
server/data/
server/data-*/
data/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Go ----
server/fzucheckin
server/fzucheckin.exe
*.exe
*.test
*.out

# ---- 运行时 ----
*.log
.DS_Store
# ---- 构建产物（不入库）----
dist/

# ---- 部署模板与部署记录：一律只留本机，不入库 ----
# deploy/ 下是「我这台机器怎么部署的」：真实路径、端口、备份文件名、域名约定，
# 不属于可公开仓库的内容。注意 .gitignore 对「已被跟踪」的文件无效——
# 目录要真离开仓库，还得配一次 git rm -r --cached deploy（历史则要 filter-repo）。
deploy/

# ---- 浏览器导出的 Cookie / 抓包现场：含真实会话凭据，绝不入库 ----
docs/**/cookies*.json
docs/**/cookie*.txt
.recon/

# ---- 截图一律不入库 ----
# 任何 UI 截图都可能带出：本机绝对路径与用户名（C:\Users\<name>）、签到坐标（楼栋级）、
# 学号 / token 的残留回显、日志里的真实接口地址。这些信息一旦进 git，撤回也删不干净
# （fork、GitHub 的 SHA 缓存窗口）。截图只作为本地验收物，需要时就地生成、就地查看。
# scripts/ui-verify.ps1 的输出目录就是这里，所以忽略整个目录最省事。
docs/verify-shots/
.shots/

# ---- 测试与测试数据：一律不入库 ----
# 单元测试、E2E 验收脚本、以及它们依赖的语料/向量（Python↔Go 一致性语料、AES 向量）
# 都只留在本机：仓库对外只分发源码与部署模板。删掉这些路径的 .gitignore 规则再
# git add 就能重新纳入版本控制——注意历史里已有的 blob 不会因此消失，需 filter-repo。
tests/
**/*_test.go
server/testdata/
*.test
.pytest_cache/
scripts/gen_parity.py
scripts/smoke.ps1
scripts/ui-verify.ps1
scripts/ui-verify.mjs

# ---- 兜底：临时数据 / 编辑器垃圾 / 其它二进制（2026-11-19 补） ----
# 上面按目录分的规则是主力；这一组是"随手放进来也不会被提交"的兜底。
# 同一条规矩在 scripts/repo-guard.sh 里有一份可执行的版本（pre-commit + CI 双跑），
# 因为 .gitignore 挡不住 `git add -f`。
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
*.db
*.sqlite
*.sqlite3
*.prof
*.pprof
*.dmp
*.trace
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.pem
*.p12
*.pfx
.env
.env.*
.idea/
.vs/
node_modules/
*.iml
# ---- 校验脚本与验收快照：与 tests/ 同一条口径，只留本机 ----
# 一致性用例表与 UI id 基线都是「跑验收才用得上」的东西，而运行器本身
#（scripts/ui-verify.*）早已不入库；只清运行器、不清数据，就等于留了一条暗门。
scripts/check-address-parity.mjs
docs/ui-baseline-ids.txt
