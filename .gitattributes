# 部署脚本要在 Linux 上直接执行：强制 LF，避免 Windows 检出成 CRLF 后
# 出现 "bad interpreter: /usr/bin/env bash^M"（本仓库会 scp 到 Linux 运行）。
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf

# Go 源码与前端资源保持 LF
*.go      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf

# 钩子与扫描规则也要在 Linux/macOS 上直接跑：CRLF 会让 sh 报 $'\r': command not found。
.githooks/* text eol=lf
*.awk      text eol=lf

# workflow 的 run: 段同样是 Linux 上执行的 shell 脚本，检出成 CRLF 会在 runner 上
# 报 "syntax error near unexpected token"（CI 只在 Linux 跑，没有容错空间）。
*.yml      text eol=lf
*.yaml     text eol=lf
