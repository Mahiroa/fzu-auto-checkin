# 部署脚本要在 Linux 上直接执行：强制 LF，避免 Windows 检出成 CRLF 后
# 出现 "bad interpreter: /usr/bin/env bash^M"（本仓库会 scp 到 Linux 运行）。
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf

# Go 源码与前端资源保持 LF
*.go      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
